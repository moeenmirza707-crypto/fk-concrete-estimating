# ==============================================================================
# FK Concrete Estimating - Environment Configuration Template
# ==============================================================================
# NOTE: Do NOT commit production credentials or sensitive keys to source control.
# Copy this file to .env.local for local development.

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://fkconcreteestimating.com

# Business Contact Information (Owner Confirmation Required)
# When verified by the business owner, set these values to display live numbers and emails.
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY=
NEXT_PUBLIC_BUSINESS_EMAIL=estimates@fkconcreteestimating.com

# Form Submission Webhook / CRM Integration
# Optional: Set this to a webhook endpoint (e.g. Zapier, Make, Slack, HubSpot, or custom CRM)
# to automatically receive estimate requests submitted through the website form.
ESTIMATE_WEBHOOK_URL=

# Optional Email Dispatch Service (e.g., Resend, SendGrid, Postmark)
EMAIL_API_KEY=
NOTIFICATION_RECIPIENT_EMAIL=estimates@fkconcreteestimating.com

# Optional Analytics & Search Console Verification
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
GOOGLE_SITE_VERIFICATION_TOKEN=

